---
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta
      name="description"
      content="Osyris. I make games & tools for making games."
    />
    <meta property="og:title" content="Osyris" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Osyris" />
    <meta
      property="og:description"
      content="I make games & tools for making games."
    />
    <meta property="og:image" content="https://osyr.is/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Oversized Osyris lettering and a red BiggerHead against a stark black background."
    />
    <meta property="og:url" content="https://osyr.is" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/png" href="/assets/pixel-avatar.png" />
    <title>Osyris</title>
  </head>
  <body class="poster-page">
    <a class="skip-link" href="#projects">
      Skip to projects
    </a>
    <main>
      <section class="poster-hero" aria-labelledby="hero-title">
        <header class="site-header">
          <a class="brand" href="/" aria-label="Osyris home">
            osyr.is
          </a>
          <nav aria-label="Main navigation">
            <a
              href="https://github.com/osyrisrblx"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src="/assets/github.svg" alt="" width="18" height="18" />
              GitHub <Icon name="arrow" />
            </a>
            <a
              href="https://www.roblox.com/users/83348/profile"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="roblox-icon" aria-hidden="true"></span>Roblox{' '}
              <Icon name="arrow" />
            </a>
          </nav>
        </header>
        <p class="intro">
          I make games
          <br />
          &amp; tools for
          <br />
          making games.
        </p>
        <div class="head-playground">
          <div
            id="head-stage"
            class="head-stage"
            aria-label="Interactive BiggerHead"
          >
            <canvas
              id="head-canvas"
              hidden
              tabindex="0"
              role="img"
              aria-label="3D BiggerHead. Drag to spin, or use the arrow keys."
              aria-describedby="head-help"
            ></canvas>
          </div>
        </div>
        <h1 id="hero-title">OSYRIS</h1>
        <p id="head-help" class="sr-only">
          Drag to spin. Use the arrow keys to turn.
        </p>
        <p id="scene-status" class="sr-only" role="status">
          The interactive head requires JavaScript.
        </p>
      </section>
      <section
        id="projects"
        class="projects"
        aria-labelledby="projects-title"
        tabindex="-1"
      >
        <h2 id="projects-title" class="sr-only">
          Projects
        </h2>
        <ProjectLinks />
        <a
          class="more-projects"
          href="https://github.com/osyrisrblx?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
        >
          All repositories <Icon name="arrow" />
        </a>
        <a
          class="support-link"
          href="https://github.com/sponsors/osyrisrblx"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sponsor on GitHub"
        >
          <Icon name="heart" /> Support my work
        </a>
      </section>
    </main>
    <script>
      import { showHeadUnavailable } from '../scripts/playground-status';
      document.querySelector('#scene-status')!.textContent =
        'Loading the interactive head.';
      import('../scripts/playground')
        .then(({ initPlayground }) => initPlayground())
        .catch(() => showHeadUnavailable());
    </script>
  </body>
</html>
