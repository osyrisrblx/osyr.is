---
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#080808" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/png" href="/assets/pixel-avatar.png" />
		<title>Page not found</title>
	</head>
	<body>
		<main class="not-found">
			<span class="error-label">OSYR.IS / PAGE NOT FOUND</span>
			<h1>
				404<span>.</span>
			</h1>
			<a href="/">
				Back home <Icon name="arrow" />
			</a>
		</main>
	</body>
</html>

<style>
	.not-found {
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 48px;
		max-width: 1100px;
		padding: 40px;
		margin: auto;
	}
	.error-label {
		font:
			12px 'Courier New',
			monospace;
	}
	.not-found h1 {
		font-size: clamp(120px, 28vw, 360px);
	}
	.not-found h1 span {
		color: var(--red);
	}
	.not-found a {
		padding: 20px 24px;
		border: var(--line);
		display: flex;
		gap: 60px;
		text-transform: uppercase;
		font-size: 14px;
	}
	.not-found a:hover {
		color: var(--surface);
		background: var(--text);
	}
</style>
