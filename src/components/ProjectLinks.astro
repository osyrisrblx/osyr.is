---
import Icon from './Icon.astro';
---

<div class="project-list">
	<a
		class="project-card"
		href="https://roblox-ts.com"
		target="_blank"
		rel="noopener noreferrer"
	>
		<span class="project-index" aria-hidden="true">
			01
		</span>
		<img
			class="project-logo"
			src="/assets/roblox-ts.svg"
			alt=""
			width="44"
			height="44"
		/>
		<span class="project-copy">
			<strong>roblox-ts</strong>
			<span>TypeScript → Luau</span>
		</span>
		<Icon name="arrow" class="project-arrow" />
	</a>
	<a
		class="project-card"
		href="https://github.com/osyrisrblx/t"
		target="_blank"
		rel="noopener noreferrer"
	>
		<span class="project-index" aria-hidden="true">
			02
		</span>
		<span class="project-mark" aria-hidden="true">
			t
		</span>
		<span class="project-copy">
			<strong>t</strong>
			<span>Runtime typechecking</span>
		</span>
		<Icon name="arrow" class="project-arrow" />
	</a>
</div>
